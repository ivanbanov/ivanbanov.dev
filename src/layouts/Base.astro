---
interface Props {
  title: string;
  description: string;
  markdownHref: string;
  /** 1200×630 card generated by scripts/generate-og.cjs */
  ogImage: string;
  colorScheme?: string;
}
const { title, description, markdownHref, ogImage: ogPath, colorScheme = "light dark" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogPath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content={colorScheme} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ivan Banov" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — card with portrait of Ivan Banov`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/markdown" href={markdownHref} />
    <script is:inline>
      // Theme controller. Runs before first paint to avoid a flash.
      //  - No saved choice → follow the OS, live (matchMedia "change").
      //  - Saved choice ("light" | "dark") → wins on every page, tab, and
      //    back/forward restore (pageshow + storage events).
      (function () {
        var KEY = "theme";
        var root = document.documentElement;
        var mq = matchMedia("(prefers-color-scheme: dark)");

        function saved() {
          try {
            var t = localStorage.getItem(KEY);
            if (!t) {
              // migrate the old key
              t = localStorage.getItem("cv-theme");
              if (t) {
                localStorage.setItem(KEY, t);
                localStorage.removeItem("cv-theme");
              }
            }
            return t === "light" || t === "dark" ? t : null;
          } catch (e) {
            return null;
          }
        }
        function apply() {
          root.setAttribute("data-theme", saved() || (mq.matches ? "dark" : "light"));
        }
        function set(t) {
          try {
            localStorage.setItem(KEY, t);
          } catch (e) {}
          apply();
        }

        apply();
        mq.addEventListener("change", apply);
        addEventListener("storage", function (e) {
          if (e.key === KEY || e.key === null) apply();
        });
        addEventListener("pageshow", function (e) {
          if (e.persisted) apply();
        });
        document.addEventListener("click", function (e) {
          if (e.target.closest && e.target.closest("[data-theme-toggle]")) {
            set(root.getAttribute("data-theme") === "dark" ? "light" : "dark");
          }
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Vercel Web Analytics -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
