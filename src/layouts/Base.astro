---
interface Props {
  title: string;
  description: string;
  markdownHref: string;
  /** 1200×630 card generated by scripts/generate-og.cjs */
  ogImage: string;
  colorScheme?: string;
}
const { title, description, markdownHref, ogImage: ogPath, colorScheme = "light dark" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogPath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content={colorScheme} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ivan Banov" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — card with portrait of Ivan Banov`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/markdown" href={markdownHref} />
    <script is:inline>
      // Apply the saved/preferred theme before first paint to avoid a flash.
      (function () {
        var t = null;
        try {
          t = localStorage.getItem("cv-theme");
        } catch (e) {}
        if (!t && matchMedia("(prefers-color-scheme: dark)").matches) t = "dark";
        if (t) document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Vercel Web Analytics -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
