---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import "../styles/cv.css";

const entry = (await getEntry("pages", "cv"))!;
const { Content, headings } = await render(entry);
// Top-level nav = the H2 sections of content/cv.md
const sections = headings.filter((h) => h.depth === 2);

const fonts = [
  "fraunces.woff2",
  "fraunces-italic.woff2",
  "newsreader.woff2",
  "newsreader-italic.woff2",
  "jetbrains-mono.woff2",
];
---

<Base title={entry.data.title} description={entry.data.description} markdownHref="/cv.md" ogImage="/og/cv.png">
  <Fragment slot="head">
    {fonts.map((f) => <link rel="preload" href={`/fonts/${f}`} as="font" type="font/woff2" crossorigin />)}
  </Fragment>

  <header class="topbar">
    <div class="topbar__inner wrap">
      <nav class="topbar__nav">
        {sections.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
      <div class="topbar__actions">
        <a class="iconbtn" href="/cv/Ivan-Banov-CV.pdf" download title="Download PDF" aria-label="Download PDF">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 3v12M8 11l4 4 4-4M5 20h14" />
          </svg>
        </a>
        <button class="iconbtn" id="print" title="Save as PDF" aria-label="Save as PDF">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M6 9V3h12v6M6 18H4v-6h16v6h-2M8 14h8v7H8z" />
          </svg>
        </button>
        <button class="iconbtn" id="theme" title="Toggle theme" aria-label="Toggle theme">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
          </svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8z" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main class="prose wrap">
    <Content />
  </main>

  <script>
    const root = document.documentElement;
    document.getElementById("theme")!.addEventListener("click", () => {
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("cv-theme", next);
      } catch {}
    });
    document.getElementById("print")!.addEventListener("click", () => window.print());
  </script>
</Base>
